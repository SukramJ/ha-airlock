# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go is tab-indented (gofumpt); Makefiles require tabs.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{js,mjs,cjs,ts,json,jsonc,css,html,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (hard line breaks are significant).
[*.md]
trim_trailing_whitespace = false
