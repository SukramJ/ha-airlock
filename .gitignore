# Build output and local test artefacts.
/bin/
/ha-airlock
*.test
*.out

# IDE project state. GoLand writes .idea/ into any directory it opens; none
# of it describes the module.
.idea/
.DS_Store

# Claude Code agent worktrees and machine-local settings.
/.claude/worktrees/
/.claude/settings.local.json

# Local credentials and runtime state. A Home Assistant token, the audit
# log and the snapshot store never belong in the repository.
.env
*.token
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
